#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/tailscale-setup.log) 2>&1

# 1) IP 포워딩 켜기: 다른 사이트로 가는 패킷을 대신 넘겨주려면 필요
cat > /etc/sysctl.d/99-tailscale.conf <<'EOF'
net.ipv4.ip_forward = 1
net.ipv6.conf.all.forwarding = 1
EOF
sysctl -p /etc/sysctl.d/99-tailscale.conf

# 2) Tailscale 설치 (공식 설치 스크립트)
curl -fsSL https://tailscale.com/install.sh | sh
systemctl enable --now tailscaled

# 2-1) UDP GRO 설정: 서브넷 라우터의 터널 처리 성능 개선 (Tailscale 권장)
dnf install -y ethtool
NETDEV=$(ip -o route get 8.8.8.8 | cut -f 5 -d " ")
ethtool -K "$NETDEV" rx-udp-gro-forwarding on rx-gro-list off

# 3) 인증 키 읽기: 서버 자신의 IAM 역할로 Parameter Store에서 꺼냄
AUTHKEY=$(aws ssm get-parameter --region "${region}" --name "${authkey_param}" --with-decryption --query Parameter.Value --output text)

if [ "$AUTHKEY" = "placeholder" ]; then
  echo "[tailscale] auth key is placeholder - skip tailscale up"
  exit 0
fi

# 4) tailnet 가입 + VPC 대역 광고
tailscale up \
  --auth-key="$AUTHKEY" \
  --hostname="${hostname}" \
  --advertise-tags=tag:aws \
  --advertise-routes="${vpc_cidr}" \
  --accept-routes